# Copy to .env (never commit it). Everything here is optional: you can also set keys in the dashboard.

# --- Access -------------------------------------------------------------
# Fixes the dashboard password (recommended on hosts where the disk is wiped on redeploy).
# Leave empty to use the one-time password printed on first run.
ADMIN_PASSWORD=

# Optional: stable secret for login cookies. Default is generated and stored in data/.
SESSION_SECRET=

# --- Free AI engines (any one is enough; more = automatic failover) -------
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Optional lead source: Explee -----------------------------------------
# Lead generation only. This integration never sends outreach; campaigns stay
# paused/review. Searches stay inside the free-results zone (10 results per
# request, 50 free requests/day). Explee needs a positive balance even for
# free results, so a funded key is required.
EXPLEE_API_KEY=
# Lifetime credit ceiling (1 credit = $0.01). 3000 = $30 for the whole life of
# the install. 0 disables paid enrichment (email/phone lookups) entirely.
EXPLEE_LIFETIME_CREDIT_BUDGET=3000
# Number of months the ceiling has to last. 60 = five years.
EXPLEE_BUDGET_MONTHS=60
# Optional default search countries as ISO-2 codes, comma separated.
# Leave empty to search worldwide.
EXPLEE_DEFAULT_COUNTRIES=

# --- Optional free lead source --------------------------------------------
# Geoapify API key (free plan: 3,000 credits/day, no card). Used only when
# "Geoapify places" is ticked in Find leads. Requires the OSM/Geoapify
# attribution shown in the dashboard. Leave empty to keep it off.
GEOAPIFY_API_KEY=

# --- Telegram bot (optional) ---------------------------------------------
TELEGRAM_BOT_TOKEN=

# --- Server ---------------------------------------------------------------
PORT=3000
# 127.0.0.1 = this computer only. Use 0.0.0.0 only inside Docker or behind a firewall.
HOST=127.0.0.1
# Set to 1 ONLY when running behind your own proxy/tunnel (Cloudflare Tunnel, Caddy, Nginx).
# Without it every visitor shares one IP address and rate limits misbehave; with it on a
# directly exposed server, visitors could fake their IP.
TRUST_PROXY=
# Where leads, chats and settings are stored.
DATA_DIR=

# --- Docker Compose only --------------------------------------------------
DOMAIN=agent.example.com
